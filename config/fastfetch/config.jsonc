{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 2,
      "left": 2,
      "right": 3,
    },
    // "logo": {
    //   "source": "~/.config/fastfetch/icons/uwu.txt",
    //   "padding": {
    //     "top": 1,
    //     "left": 2,
    //     "right": 3,
    //   },
    "color": {
      "1": "magenta",
      "2": "blue",
    },
  },
  "display": {
    "separator": "",
    "color": {
      "keys": "blue",
    },
    "key": {
      "type": "both",
      "width": 15,
      "paddingLeft": 3,
    },
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "┏━          \u001B[32m{2}\u001b[0m@\u001B[35m{1}\u001B[0m          ━┓",
    },
    "break",
    {
      "type": "os",
      "key": "Distro ",
      "keyIcon": "󰣇",
    },
    {
      "type": "kernel",
      "keyIcon": "󰌽",
    },
    {
      "type": "packages",
      "keyIcon": "󰮯",
    },
    {
      "type": "uptime",
      "keyIcon": "",
    },
    {
      "type": "memory",
      "keyIcon": "󰍛",
    },
    "break",
    {
      "type": "custom",
      "format": "┗━                                       ━┛",
    },
    {
      "type": "colors",
      "symbol": "diamond",
      "paddingLeft": 13,
    },
    "break",
  ],
}
