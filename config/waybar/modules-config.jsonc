{
  "layer": "top",
  "spacing": 4,
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,
  "reload_style_on_change": true,

  // ----------- MODULES CONFIG ------------

  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 18,
    "spacing": 3,
    "tooltip-format": "{title}",
    "on-click-middle": "close",
    "on-click": "activate",
    "ignore-list": ["Alacritty"],
  },

  //////////// hyprland modules ////////////

  "hyprland/window": {
    "format": "{initialTitle}",
    "max-length": 40,
    "all-outputs": true,
  },
  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch workspace e-1",
    "on-scroll-down": "hyprctl dispatch workspace e+1",
    "all-outputs": true,
    "warp-on-scroll": true,
    "enable-bar-scroll": true,
    "disable-scroll-wraparound": true,
  },

  //////////////// other modules ///////////////

  "tray": {
    "icon-size": 18,
    "spacing": 10,
  },

  "memory": {
    "format": "  {percentage}%",
    "interval": 5,
    "on-click": "alacritty -e btop",
  },

  "mpris": {
    "format": "{status_icon} {dynamic}",
    "interval": 1,
    "dynamic-len": 40,
    "status-icons": {
      "paused": " ",
      "playing": " ",
      "stopped": " ",
    },
    "tooltip-format": "{title} - {artist} | {length}",
    "dynamic-order": ["title", "artist", "album", "position", "length"],
    "ignored-players": ["firefox"],
    "align": "1",
    "justify": "center",
    "on-click-middle": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-click": "playerctl previous",
  },
  "clock": {
    "format": "{:%I:%M %p}",
    // "format": "{:%I:%M %p • %a %d/%m}",
    "tooltip": true,
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "days": "<span color='#ecc6d9'><b>{}</b></span>",
        "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b><u>{}</u></b></span>",
      },
      "on-click-right": "mode",
    },
    "actions": {
      "on-click-right": "mode",
      "on-click-forward": "tz_up",
      "on-click-backward": "tz_down",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down",
    },
  },

  "backlight": {
    "scroll-step": 5,
    "format": "{icon}{percent}",
    "format-icons": ["󰃞 ", "󰃟 ", "󰃝 ", "󰃠 "],
    "on-click": "brightnessctl set 5%-",
    "on-click-right": "brightnessctl set +5%",
  },

  "network": {
    "format-wifi": " {icon}",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤠",
    "format-icons": ["󰤯 ", "󰤟 ", "󰤢 ", "󰤢 ", "󰤨 "],
    "interval": 5,
    "tooltip-format-wifi": " {bandwidthDownBytes} |  {bandwidthUpBytes} | {essid}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "iwmenu --menu rofi",
  },
  "battery": {
    "states": {
      "good": 95,
      "fair": 65,
      "warning": 40,
      "critical": 15,
    },
    "format": "{icon} {capacity}",
    "format-full": "",
    "format-charging": "{capacity} ",
    "format-plugged": "{capacity} ",
    "format-alt": "{icon} {time}",
    "tooltip-format": "{capacity}%, about {time} left",
    "format-icons": [" ", " ", " ", " "],
    "on-click": "tlpui",
  },

  "wireplumber": {
    "max-volume": 120,
    "scroll-step": 5, // %, can be a float
    "format": "{icon}{volume}",
    "format-bluetooth": "{icon} {volume}",
    "format-icons": [" ", " ", "  "],
    "format-muted": " ",
    "on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click": "pwvucontrol",
  },
  "pulseaudio": {
    "format": "{format_source}",
    "format-source": "",
    "format-source-muted": " ",
    "on-click": "pwvucontrol",
  },

  "bluetooth": {
    "format": "{icon}",
    "format-icons": ["󰂱", "󰤾", "󰥀", "󰥄", "󰥈"],
    "format-disabled": "󰂲",
    "format-connected": "{icon} {device-alias}",
    "format-connected-battery": "{icon} {device_battery_percentage}%",

    "tooltip-format-on": "Bluetooth is on",
    "tooltip-format-off": "Bluetooth is off",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_battery_percentage}%",

    "on-click": "blueman-manager",
  },
  ///////////////// custom: chatGPT ////////////
  "custom/chatGPT": {
    "format": "󱙺",
    "tooltip": true,
    "tooltip-format": "Open chatGPT",
    "justify": "center",
    "on-click": "chromium --app=https://chat.openai.com",
  },
  ///////////////// group: power ///////////////
  "group/power": {
    "orientation": "inherit",
    "drawer": {
      "click-to-reveal": true,
      "transition-duration": 500,
      "transition-left-to-right": false,
    },
    "modules": [
      "custom/power",

      "custom/logout",
      "custom/suspend",
      "custom/reboot",
      "custom/shutdown",
    ],
  },

  "custom/power": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "I use Arch, btw.",
    "justify": "center",
  },

  "custom/suspend": {
    "format": "󰒲",
    "tooltip": true,
    "tooltip-format": "sleep",
    "on-click": "systemctl suspend",
    "justify": "center",
  },

  "custom/reboot": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "reboot",
    "justify": "center",
    "on-click": "(sleep 5 && reboot) & (notify-send -a System --urgency=critical --expire-time=5000 --wait 'System reboot' 'The system will reboot in 5 seconds, click to cancel' && pkill sleep)",
  },

  "custom/shutdown": {
    "format": "⏻",
    "tooltip": true,
    "tooltip-format": "shutdown",
    "justify": "center",
    "on-click": "(sleep 5 && shutdown now) & (notify-send -a System --urgency=critical --expire-time=5000 --wait 'System Shutdown' 'The system will shutdown in 5 seconds, click to cancel' && pkill sleep)",
  },
  "custom/logout": {
    "format": "󰍃",
    "tooltip": true,
    "tooltip-format": "logout",
    "justify": "center",
    "on-click": "loginctl terminate-session $XDG_SESSION_ID",
  },

  "group/audio-and-light": {
    "orientation": "inherit",
    "modules": ["pulseaudio", "wireplumber", "backlight"],
  },
  "group/connections": {
    "orientation": "inherit",
    "modules": ["bluetooth", "network"],
  },

  "custom/mpris_prev": {
    "format": "",
    "justify": "center",
    "on-click": "playerctl previous",
  },
  "custom/mpris_plp": {
    "format": "󰎇",
    "justify": "center",
    "on-click": "playerctl play-pause",
  },
  "custom/mpris_next": {
    "format": "",
    "justify": "center",
    "on-click": "playerctl next",
  },

  "group/music_control": {
    "orientation": "inherit",
    "modules": [
      "custom/mpris_prev",
      "custom/mpris_plp",
      "custom/mpris_next",
      "mpris",
    ],
  },
  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": " <span foreground='red'><sup></sup></span>",
      "none": "",
      "dnd-notification": " <span foreground='red'><sup></sup></span>",
      "dnd-none": " ",
      "inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "inhibited-none": "",
      "dnd-inhibited-notification": " <span foreground='red'><sup></sup></span>",
      "dnd-inhibited-none": " ",
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true,
  },
}
