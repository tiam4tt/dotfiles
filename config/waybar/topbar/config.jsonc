[
  {
    "output": ["*"],
    "include": ["~/.config/waybar/modules-config.jsonc"],
    "position": "top",
    "margin-top": 3,
    "margin-bottom": 3,

    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": [
      "tray",
      "memory",
      "group/audio-and-light",
      "group/connections",
      "battery",
      "group/power",
    ],
    "battery": {
      "format": "{icon}",
    },
    "network": {
      "format-wifi": "{icon} {essid}",
    },
    "hyprland/window": {
      "format": "{title}",
      "expand": true,
    },
  },
]
