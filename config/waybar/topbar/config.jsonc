[
  {
    "output": ["*"],
    "include": ["~/.config/waybar/modules-config.jsonc"],
    "position": "top",
    "margin-top": 0,
    "margin-bottom": 0,

    "modules-left": ["hyprland/workspaces", "wlr/taskbar"],
    "modules-center": ["mpris", "clock"],
    "modules-right": [
      "tray",
      // "memory",
      "wireplumber",
      "backlight",
      "bluetooth",
      "network",
      "battery",
      "group/power",
    ],
    "battery": {
      "format": "{icon}",
    },
    "network": {
      "format-wifi": "{icon} {essid}",
    },
  }
]
