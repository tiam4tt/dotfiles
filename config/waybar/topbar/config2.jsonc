[
  {
    "output": ["*"],
    "include": ["~/.config/waybar/modules-config.jsonc"],
    "position": "top",
    "margin": "0 0 0 0",

    "modules-left": ["group/power", "hyprland/workspaces", "wlr/taskbar"],
    "modules-center": ["mpris", "hyprland/window"],
    "modules-right": [
      "tray",
      "wireplumber",
      "backlight",
      "network",
      "bluetooth",
      "battery",
      "clock",
    ],
    "hyprland/workspaces": {
      "format": "{icon}",
      "on-click": "activate",
      "on-scroll-up": "hyprctl dispatch workspace e-1",
      "on-scroll-down": "hyprctl dispatch workspace e+1",
    },
    "network": {
      "format-wifi": "{icon} {essid}",
    },
    "group/power": {
      "drawer": {
        "transition-left-to-right": true,
      },
    },
  },
]
