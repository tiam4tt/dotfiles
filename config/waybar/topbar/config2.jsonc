[
  {
    "output": [
      "*"
    ],
    "include": [
      "~/.config/waybar/modules-config.jsonc"
    ],
    "position": "top",
    "margin": "0 0 0 0",
    "modules-left": [
      "group/power",
      "hyprland/workspaces"
    ],
    "modules-center": [
      "mpris",
      "hyprland/window"
    ],
    "modules-right": [
      "tray",
      "memory",
      "pulseaudio",
      "wireplumber",
      "backlight",
      "network",
      "bluetooth",
      "clock",
      "custom/notification",
      "battery",
    ],
    "hyprland/workspaces": {
      "format": "{icon}",
      "on-click": "activate",
      "on-scroll-up": "hyprctl dispatch workspace e-1",
      "on-scroll-down": "hyprctl dispatch workspace e+1",
    },
    "network": {
      "format-wifi": "{icon} {essid}",
    },
    "group/power": {
      "drawer": {
        "transition-left-to-right": true,
      },
    },
  },
]