[
  {
    "output": [
      "*"
    ],
    "include": [
      "~/.config/waybar/modules-config.jsonc"
    ],
    "position": "top",
    "margin": "0",
    // "height": 28,
    "modules-left": [
      "hyprland/workspaces",
      "hyprland/window"
    ],
    "modules-center": [
      "mpris"
    ],
    "modules-right": [
      "tray",
      "memory",
      "group/audio-and-light",
      "group/connections",
      "clock",
      "battery",
      "group/power",
    ],
    "hyprland/window": {
      "format": "{title}",
      "icon": false,
      "icon-size": 18,
      // "max-length": 40,
      "expand": true,
    },
    "hyprland/workspaces": {
      "format": "{icon}",
      "format-icons": {
        "active": "󰮯",
        "urgent": "󱙝",
        "default": "󱙝",
      },
    },
    "network": {
      "format-wifi": "{icon}",
    },
    "group/power": {
      "drawer": {
        "transition-left-to-right": false,
      },
    },
    "mpris": {
      "ignored-players": [
        "firefox"
      ],
    },
  },
]