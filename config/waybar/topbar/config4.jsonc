[
  {
    "output": [
      "*"
    ],
    "include": [
      "~/.config/waybar/modules-config.jsonc"
    ],
    "position": "top",
    "margin": "2 5 1",
    "modules-left": [
      "clock",
      "hyprland/workspaces",
      "hyprland/window"
    ],
    "modules-center": [
      "mpris"
    ],
    "modules-right": [
      "network",
      "memory",
      "bluetooth",
      "pulseaudio",
      "wireplumber",
      "backlight",
      "custom/notification",
      "battery",
      "group/power",
    ],
    "battery": {
      "format": "{icon}",
    },
    "network": {
      "format-wifi": " {bandwidthDownBytes} -  {bandwidthUpBytes}",
      "tooltip-format-wifi": "{essid}",
    },
    "hyprland/window": {
      "format": "{initialTitle}",
      "expand": true,
    },
  },
]